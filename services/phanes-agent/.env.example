# Copy to .env and fill in. Secrets are never committed; inject real values
# via environment variables (they override .env).
APP_ENV=development

# OpenRouter — REQUIRED. Left empty on purpose; the service fails fast at
# startup with a clear error if missing.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# MySQL (docker-compose defaults)
DATABASE_URL=mysql+aiomysql://phanes:phanes@localhost:3306/phanes_agent

# Phoenix trace debug UI (docker-compose default). Set PHOENIX_ENABLED=false
# to run without it.
PHOENIX_ENABLED=true
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_PROJECT=phanes-agent

# Runtime knobs
MAX_CONCURRENT_RUNS=8
RUN_TIMEOUT_SECONDS=300
