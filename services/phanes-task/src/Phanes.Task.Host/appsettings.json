{
  "Serilog": {
    "MinimumLevel": "Information"
  },
  "PhanesTask": {
    "Kafka": {
      "BootstrapServers": "192.168.0.21:9094",
      "Topic": "phanes.task.events",
      "ConsumerGroup": "phanes-task"
    },
    "Redis": {
      "ConnectionString": "",
      "KeyPrefix": "phanes:task",
      "StatusTtlSeconds": 604800
    },
    "Dispatcher": {
      "MaxDelaySeconds": 3600
    },
    "ConfigService": {
      "Url": "",
      "Namespace": "phanes-task",
      "Key": "options",
      "PollSeconds": 15
    },
    "MySQL": {
      "ConnectionString": ""
    },
    "Worker": {
      "ActorIdleTimeoutSeconds": 300,
      "ActorScanIntervalSeconds": 30,
      "ActorMailboxCapacity": 64,
      "MaxChainDepth": 64,
      "WatermarkCommitIntervalSeconds": 2,
      "WatermarkStuckSeconds": 300
    }
  }
}
